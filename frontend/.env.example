# ─────────────────────────────────────────
# Frontend Environment Variables (Example)
# ─────────────────────────────────────────
# Copy this file to `.env` and fill real values.
# Vite only exposes variables starting with VITE_
# ─────────────────────────────────────────

# Backend API URL
VITE_API_URL=http://localhost:5000/api

# App Config
VITE_APP_NAME=Bright Future Public School
VITE_APP_SHORT_NAME=BFPS
VITE_APP_TAGLINE=Connect • Learn • Grow

# Session
VITE_ACADEMIC_SESSION=2026-27
